APP_NAME="GBX Panel"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_COOKIE=gbx_session

CACHE_STORE=file
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=3700
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# GBX Panel
GBX_ROOT=/usr/local/gbxpanel
GBX_PORT=8888
GBX_ENTRY=
GBX_SSL=true
GBX_DOMAIN=
GBX_SSL_CERT=
GBX_SSL_KEY=
GBX_SIMULATE=false
GBX_USE_SUDO=true
GBX_DEFAULT_PHP=8.4

# ClamAV (Security > Antivirus)
GBX_CLAMD_SOCKET=/var/run/clamav/clamd.ctl
GBX_QUARANTINE=/www/quarantine

# Venice AI (optional fallback, the key is normally set in Settings > AI)
VENICE_AI_API_KEY=
VENICE_AI_VISION_MODEL=qwen3-vl-235b-a22b
