#!/usr/bin/env bash
#
#  gbx - GBX Panel command line tool
#
#  gbx                       interactive menu
#  gbx <number>              run a menu option directly (e.g. gbx 7)
#
#  gbx info                  panel URL and login (password hidden)
#  gbx default               show the initial login if the password was never changed
#  gbx restart | stop | start | status
#  gbx password [pass]       change the admin password (random when empty)
#  gbx username <name>       change the admin username
#  gbx 2fa-off [user]        disable two-factor authentication of an account (lost phone)
#  gbx port <port>           change the panel port
#  gbx entry <path|off>      change or disable the security entrance
#  gbx ssl on|off            enable (self-signed) or disable HTTPS on the panel
#  gbx ssl letsencrypt <email>  issue a Let's Encrypt certificate for the bound domain
#  gbx domain <name|off>     bind the panel to a domain or remove the binding
#  gbx cache                 clear panel cache
#  gbx unlock-login          clear failed-login lockouts
#  gbx unlock-ip             clear the IP allow list
#  gbx doctor                check services, permissions and the login page
#  gbx fpm                   (re)create the dedicated gbxpanel-fpm service
#  gbx terminal [on|off|status|restart]  real-time web terminal service
#  gbx tools-access public|private  phpMyAdmin/Adminer for everyone or only through the panel
#  gbx fix | update | logs | vhost | uninstall
#
set -uo pipefail

GBX_ROOT="/usr/local/gbxpanel"
PANEL_DIR="$GBX_ROOT/panel"
ENV_FILE="$PANEL_DIR/.env"
GBX_USER="gbxpanel"
PHP_BIN="/usr/bin/php8.4"
VHOST="/etc/apache2/sites-available/000-gbxpanel.conf"
SELF_CERT="$GBX_ROOT/ssl/panel.crt"
SELF_KEY="$GBX_ROOT/ssl/panel.key"
FPM_BIN="/usr/sbin/php-fpm8.4"
FPM_DIR="$GBX_ROOT/fpm"
FPM_SOCK="/run/gbxpanel/php-fpm.sock"
FPM_UNIT="/etc/systemd/system/gbxpanel-fpm.service"
TERM_BIN="$GBX_ROOT/bin/gbx-terminal"
TERM_UNIT="/etc/systemd/system/gbxpanel-terminal.service"
GBX_REPO="${GBX_REPO:-https://github.com/humolot/gbxpanel}"
GBX_BRANCH="${GBX_BRANCH:-main}"

if [ -t 1 ]; then
    B="\033[1m"; D="\033[2m"; G="\033[32m"; R="\033[31m"; Y="\033[33m"; C="\033[36m"; W="\033[97m"; N="\033[0m"
else
    B=""; D=""; G=""; R=""; Y=""; C=""; W=""; N=""
fi

die()  { echo -e "${R}Error:${N} $*" >&2; exit 1; }
okay() { echo -e "${G}$*${N}"; }
note() { echo -e "${Y}$*${N}"; }

[ "$(id -u)" -eq 0 ] || die "run gbx as root"
[ -f "$PANEL_DIR/artisan" ] || die "GBX Panel is not installed in $PANEL_DIR"

# ------------------------------------------------------------------ helpers
artisan() { (cd "$PANEL_DIR" && runuser -u "$GBX_USER" -- env HOME="$GBX_ROOT" "$PHP_BIN" artisan "$@"); }

env_get() { grep -E "^$1=" "$ENV_FILE" 2>/dev/null | head -1 | cut -d= -f2- | tr -d '"' || true; }

env_set() {
    if grep -qE "^$1=" "$ENV_FILE"; then
        sed -i "s#^$1=.*#$1=$2#" "$ENV_FILE"
    else
        echo "$1=$2" >>"$ENV_FILE"
    fi
}

is_true() { [[ "${1,,}" =~ ^(1|true|yes|on)$ ]]; }

scheme() { is_true "$(env_get GBX_SSL)" && echo https || echo http; }

public_ip() { curl -4 -fsS --max-time 4 https://api.ipify.org 2>/dev/null || hostname -I | awk '{print $1}'; }

panel_host() { local d; d="$(env_get GBX_DOMAIN)"; [ -n "$d" ] && echo "$d" || public_ip; }

panel_url() {
    local entry; entry="$(env_get GBX_ENTRY)"
    echo "$(scheme)://$(panel_host):$(env_get GBX_PORT)${entry:+/$entry}"
}

ask() { local prompt="$1" var; read -r -p "$prompt" var </dev/tty; echo "$var"; }

confirm() { local a; a="$(ask "$1 [y/N] ")"; [[ "$a" =~ ^[Yy]$ ]]; }

clear_cache_quiet() { artisan optimize:clear >/dev/null 2>&1; artisan view:cache >/dev/null 2>&1; }

ensure_self_signed() {
    [ -f "$SELF_CERT" ] && [ -f "$SELF_KEY" ] && return 0
    local ip; ip="$(public_ip)"
    mkdir -p "$GBX_ROOT/ssl"
    openssl req -x509 -nodes -newkey rsa:2048 -days 3650 -keyout "$SELF_KEY" -out "$SELF_CERT" \
        -subj "/O=GBX Panel/CN=${ip}" -addext "subjectAltName=IP:${ip},IP:127.0.0.1,DNS:localhost" >/dev/null 2>&1 \
        || die "could not generate a self-signed certificate"
    chmod 600 "$SELF_KEY"
}

# Dedicated PHP-FPM master for the panel.
# The distribution php8.4-fpm.service runs with ProtectSystem=full, which makes /usr and /etc
# read-only for PHP and every command it starts: the panel (in /usr/local) could not write its
# cache and sudo commands could not manage /etc. Websites keep using the hardened service.
ensure_panel_fpm() {
    mkdir -p "$FPM_DIR" "$GBX_ROOT/logs" "$GBX_ROOT/tmp"
    chown "$GBX_USER:$GBX_USER" "$GBX_ROOT/logs" "$GBX_ROOT/tmp"

    cat >"$FPM_DIR/php-fpm.conf" <<EOF
; GBX Panel PHP-FPM - generated by "gbx fpm". Do not edit by hand.
[global]
pid = /run/gbxpanel/php-fpm.pid
error_log = ${GBX_ROOT}/logs/php-fpm.log
log_level = warning
daemonize = no

[gbxpanel]
user = ${GBX_USER}
group = ${GBX_USER}
listen = ${FPM_SOCK}
listen.owner = www-data
listen.group = www-data
listen.mode = 0660

pm = ondemand
pm.max_children = 12
pm.process_idle_timeout = 30s
pm.max_requests = 500
request_terminate_timeout = 3600

php_admin_value[memory_limit] = 512M
php_admin_value[upload_max_filesize] = 2048M
php_admin_value[post_max_size] = 2048M
php_admin_value[max_execution_time] = 3600
php_admin_value[max_input_time] = 3600
php_admin_value[error_log] = ${GBX_ROOT}/logs/php-error.log
php_admin_flag[log_errors] = on
php_admin_value[upload_tmp_dir] = ${GBX_ROOT}/tmp
php_admin_value[sys_temp_dir] = ${GBX_ROOT}/tmp
php_admin_value[session.save_path] = ${GBX_ROOT}/tmp
EOF

    cat >"$FPM_UNIT" <<EOF
[Unit]
Description=GBX Panel PHP-FPM
Documentation=https://github.com/humolot/gbxpanel
After=network.target

[Service]
Type=notify
RuntimeDirectory=gbxpanel
RuntimeDirectoryMode=0755
ExecStartPre=${FPM_BIN} -t --fpm-config ${FPM_DIR}/php-fpm.conf
ExecStart=${FPM_BIN} --nodaemonize --fpm-config ${FPM_DIR}/php-fpm.conf
ExecReload=/bin/kill -USR2 \$MAINPID
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
EOF

    # remove the legacy pool that lived inside the sandboxed distribution service
    if [ -f "/etc/php/8.4/fpm/pool.d/gbxpanel.conf" ]; then
        rm -f "/etc/php/8.4/fpm/pool.d/gbxpanel.conf"
        systemctl restart php8.4-fpm >/dev/null 2>&1 || true
    fi

    systemctl daemon-reload
    systemctl enable gbxpanel-fpm >/dev/null 2>&1
    systemctl restart gbxpanel-fpm || { journalctl -u gbxpanel-fpm -n 20 --no-pager; die "gbxpanel-fpm failed to start"; }
    for _ in $(seq 1 20); do [ -S "$FPM_SOCK" ] && return 0; sleep 0.5; done
    die "PHP-FPM socket ${FPM_SOCK} was not created"
}

terminal_port() { local p; p="$(env_get GBX_TERMINAL_PORT)"; echo "${p:-17878}"; }

# Real-time web terminal: a Python 3 daemon (standard library only) that serves PTY sessions
# over WebSocket on 127.0.0.1. Apache proxies /gbx-terminal/ to it; sessions require a
# single-use token signed by the panel with APP_KEY.
ensure_terminal_service() {
    local port
    command -v python3 >/dev/null 2>&1 || DEBIAN_FRONTEND=noninteractive apt-get install -y python3 >/dev/null 2>&1 || die "python3 is required"
    if [ ! -f "$TERM_BIN" ]; then
        local raw="${GBX_REPO%/}"
        raw="${raw/github.com/raw.githubusercontent.com}/${GBX_BRANCH}/scripts/gbx-terminal"
        curl -fsSL "$raw" -o "$TERM_BIN" || { rm -f "$TERM_BIN"; die "$TERM_BIN not found and could not be downloaded (run: gbx update)"; }
    fi
    chmod 700 "$TERM_BIN"
    port="$(terminal_port)"
    env_set GBX_TERMINAL_PORT "$port"
    a2enmod -q proxy proxy_http proxy_wstunnel >/dev/null 2>&1

    cat >"$TERM_UNIT" <<EOF
[Unit]
Description=GBX Panel web terminal
Documentation=https://github.com/humolot/gbxpanel
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 ${TERM_BIN} --host 127.0.0.1 --port ${port} --env ${ENV_FILE}
WorkingDirectory=/root
Environment=HOME=/root LANG=C.UTF-8 PYTHONDONTWRITEBYTECODE=1
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload
    systemctl enable gbxpanel-terminal >/dev/null 2>&1
    systemctl restart gbxpanel-terminal || { journalctl -u gbxpanel-terminal -n 20 --no-pager; die "gbxpanel-terminal failed to start"; }
    for _ in $(seq 1 20); do
        curl -fs --max-time 2 "http://127.0.0.1:${port}/health" >/dev/null 2>&1 && return 0
        sleep 0.5
    done
    journalctl -u gbxpanel-terminal -n 20 --no-pager
    die "gbxpanel-terminal is not answering on 127.0.0.1:${port}"
}

# Generate the panel virtual host from .env (single source of truth).
write_vhost() {
    local port domain ssl cert key ssl_block="" tools_token tools_require="Require all granted"
    port="$(env_get GBX_PORT)"; domain="$(env_get GBX_DOMAIN)"; ssl="$(env_get GBX_SSL)"
    cert="$(env_get GBX_SSL_CERT)"; key="$(env_get GBX_SSL_KEY)"
    [ -n "$port" ] || die "GBX_PORT is not set in $ENV_FILE"
    [ -f "$FPM_UNIT" ] || ensure_panel_fpm
    a2enmod -q proxy proxy_http proxy_wstunnel >/dev/null 2>&1

    # phpMyAdmin and Adminer: public, or only for browsers that opened them from the panel (token cookie)
    tools_token="$(env_get GBX_TOOLS_TOKEN)"
    if [ -n "$tools_token" ] && ! is_true "$(env_get GBX_TOOLS_PUBLIC)"; then
        tools_require="Require expr \"%{HTTP_COOKIE} =~ /(^|; *)gbx_tools=${tools_token}(;|\$)/\""
    fi

    if is_true "$ssl"; then
        if [ -z "$cert" ] || [ ! -f "$cert" ] || [ ! -f "$key" ]; then
            ensure_self_signed
            cert="$SELF_CERT"; key="$SELF_KEY"
            env_set GBX_SSL_CERT "$cert"; env_set GBX_SSL_KEY "$key"
        fi
        ssl_block="    SSLEngine on
    SSLCertificateFile ${cert}
    SSLCertificateKeyFile ${key}
    Protocols h2 http/1.1"
        env_set SESSION_SECURE_COOKIE true
    else
        env_set SESSION_SECURE_COOKIE false
    fi

    [ -f "$VHOST" ] && cp "$VHOST" "$VHOST.bak"
    cat >"$VHOST" <<EOF
# GBX Panel - generated by "gbx vhost" from ${ENV_FILE}. Do not edit by hand.
Listen ${port}

<VirtualHost *:${port}>
    ServerName ${domain:-gbxpanel}
    DocumentRoot ${PANEL_DIR}/public

${ssl_block}

    <Directory ${PANEL_DIR}/public>
        Options -Indexes +FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>

    # real-time terminal (gbxpanel-terminal); sessions are authorized by single-use tokens
    ProxyPass /gbx-terminal/ ws://127.0.0.1:$(terminal_port)/ timeout=86400 keepalive=On

    <Proxy "unix:${FPM_SOCK}|fcgi://gbxpanel">
        ProxySet timeout=3600
    </Proxy>
    <FilesMatch \.php$>
        SetHandler "proxy:unix:${FPM_SOCK}|fcgi://gbxpanel"
    </FilesMatch>

    <IfFile ${GBX_ROOT}/phpmyadmin/index.php>
        Alias /phpmyadmin ${GBX_ROOT}/phpmyadmin
        <Directory ${GBX_ROOT}/phpmyadmin>
            Options -Indexes
            AllowOverride None
            ${tools_require}
            DirectoryIndex index.php
        </Directory>
    </IfFile>

    <IfFile ${GBX_ROOT}/adminer/index.php>
        Alias /adminer ${GBX_ROOT}/adminer
        <Directory ${GBX_ROOT}/adminer>
            Options -Indexes
            AllowOverride None
            ${tools_require}
            DirectoryIndex index.php
        </Directory>
    </IfFile>

    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"

    ErrorLog ${GBX_ROOT}/logs/apache-error.log
    CustomLog ${GBX_ROOT}/logs/apache-access.log combined
</VirtualHost>
EOF

    a2ensite -q 000-gbxpanel >/dev/null 2>&1
    if ! apache2ctl configtest >/dev/null 2>&1; then
        apache2ctl configtest 2>&1 | tail -5
        [ -f "$VHOST.bak" ] && mv "$VHOST.bak" "$VHOST"
        die "Apache configuration test failed; previous configuration restored"
    fi
    rm -f "$VHOST.bak"
    env_set APP_URL "$(scheme)://${domain:-127.0.0.1}:${port}"
    clear_cache_quiet
    systemctl reload apache2 || systemctl restart apache2
}

# ------------------------------------------------------------------ commands
ssl_label() {
    if ! is_true "$(env_get GBX_SSL)"; then echo -e "${Y}disabled${N}"; return; fi
    [[ "$(env_get GBX_SSL_CERT)" == /etc/letsencrypt/* ]] && echo -e "${G}enabled${N} (Let's Encrypt)" || echo -e "${G}enabled${N} (self-signed)"
}

cmd_info() {
    local entry users
    entry="$(env_get GBX_ENTRY)"
    users="$(artisan gbx:user list 2>/dev/null | awk -F'|' 'NR>3 && $5 ~ /admin/ {gsub(/ /,"",$3); printf "%s ", $3}')"
    echo
    echo -e "  ${W}${B}GBX Panel${N}"
    echo -e "  ${D}==================================================${N}"
    echo -e "  Panel URL        : ${C}${B}$(panel_url)${N}"
    [ -z "$(env_get GBX_DOMAIN)" ] && echo -e "  Internal URL     : $(scheme)://$(hostname -I | awk '{print $1}'):$(env_get GBX_PORT)${entry:+/$entry}"
    echo -e "  Username         : ${B}${users:-unknown}${N}"
    echo -e "  Password         : ******  ${D}(gbx password to change, gbx default for the initial one)${N}"
    echo -e "  ${D}--------------------------------------------------${N}"
    echo -e "  SSL              : $(ssl_label)"
    echo -e "  Bound domain     : $([ -n "$(env_get GBX_DOMAIN)" ] && env_get GBX_DOMAIN || echo -e "${D}none (IP access)${N}")"
    echo -e "  Security entrance: $([ -n "$entry" ] && echo "/$entry" || echo -e "${Y}disabled${N}")"
    echo -e "  Services         : apache2 $(systemctl is-active apache2), gbxpanel-fpm $(systemctl is-active gbxpanel-fpm), worker $(supervisorctl status 'gbxpanel-worker:*' 2>/dev/null | grep -c RUNNING)/2"
    echo
}

cmd_default() {
    local file="$GBX_ROOT/default.txt" user pass
    [ -f "$file" ] || die "no initial login stored"
    user="$(awk -F': ' '/^Username/ {print $2}' "$file")"
    pass="$(awk -F': ' '/^Password/ {print $2}' "$file")"
    if artisan gbx:user verify --user="$user" --value="$pass" >/dev/null 2>&1; then
        echo -e "\n  Panel URL : ${C}$(panel_url)${N}\n  Username  : ${B}${user}${N}\n  Password  : ${B}${pass}${N}\n"
        note "  This is still the initial password. Change it with: gbx password"
    else
        note "The initial password was already changed and cannot be shown. Use: gbx password"
    fi
}

cmd_status() { cmd_info; }

cmd_restart() {
    [ -f "$FPM_UNIT" ] || ensure_panel_fpm
    systemctl restart gbxpanel-fpm && systemctl reload apache2
    supervisorctl restart 'gbxpanel-worker:*' >/dev/null
    okay "Panel restarted."
}

cmd_stop() {
    a2dissite -q 000-gbxpanel >/dev/null 2>&1 && systemctl reload apache2
    supervisorctl stop 'gbxpanel-worker:*' >/dev/null
    note "Panel stopped. Websites keep running. Start it again with: gbx start"
}

cmd_start() {
    a2ensite -q 000-gbxpanel >/dev/null 2>&1 && systemctl reload apache2
    supervisorctl start 'gbxpanel-worker:*' >/dev/null
    okay "Panel started: $(panel_url)"
}

cmd_password() {
    local pass="${1:-}"
    if [ -z "$pass" ] && [ -t 0 ]; then
        read -r -s -p "New password (empty = random): " pass </dev/tty; echo
    fi
    [ -n "$pass" ] && [ ${#pass} -lt 8 ] && die "the password must have at least 8 characters"
    if [ -n "$pass" ]; then artisan gbx:user password --value="$pass"; else artisan gbx:user password; fi
}

cmd_2fa_off() {
    local name="${1:-}"
    [ -z "$name" ] && name="$(ask "Username (empty = first administrator): ")"
    if [ -n "$name" ]; then artisan gbx:user two-factor-off --user="$name"; else artisan gbx:user two-factor-off; fi
}

cmd_username() {
    local name="${1:-}"
    [ -z "$name" ] && name="$(ask "New username: ")"
    [ -n "$name" ] || die "username required"
    artisan gbx:user username --value="$name"
}

cmd_port() {
    local new="${1:-}" old
    old="$(env_get GBX_PORT)"
    [ -z "$new" ] && new="$(ask "New panel port (current ${old}): ")"
    [[ "$new" =~ ^[0-9]+$ ]] && [ "$new" -ge 1024 ] && [ "$new" -le 65535 ] || die "invalid port (1024-65535)"
    [ "$new" = "$old" ] && { echo "Port unchanged."; return; }
    ss -ltnH | awk '{print $4}' | grep -Eq "[:.]${new}\$" && die "port ${new} is already in use"

    env_set GBX_PORT "$new"
    if ! (write_vhost); then env_set GBX_PORT "$old"; die "port not changed"; fi
    if command -v ufw >/dev/null; then
        ufw allow "${new}/tcp" comment 'GBX Panel' >/dev/null
        ufw delete allow "${old}/tcp" >/dev/null 2>&1 || true
    fi
    okay "Panel port changed to ${new}. Open it in your provider firewall if there is one."
    cmd_info
}

cmd_entry() {
    local entry="${1:-}"
    if [ -z "$entry" ]; then
        entry="$(ask "New security entrance (empty = random, off = disable): ")"
        [ -z "$entry" ] && entry="$(tr -dc 'a-f0-9' </dev/urandom | head -c 8)"
    fi
    artisan gbx:info --set-entry="$entry" >/dev/null || die "invalid entrance (6-32 characters: letters, numbers, - and _)"
    clear_cache_quiet
    okay "Security entrance updated."
    cmd_info
}

cmd_ssl() {
    local mode="${1:-}" domain email webroot
    case "$mode" in
        on|enable|selfsigned)
            ensure_self_signed
            env_set GBX_SSL true
            # keep a Let's Encrypt certificate when one is configured
            if [ "$mode" = "selfsigned" ] || [ ! -f "$(env_get GBX_SSL_CERT)" ]; then
                env_set GBX_SSL_CERT "$SELF_CERT"; env_set GBX_SSL_KEY "$SELF_KEY"
            fi
            write_vhost
            okay "Panel SSL enabled: $(panel_url)"
            ;;
        off|disable)
            env_set GBX_SSL false
            write_vhost
            note "Panel SSL disabled: $(panel_url)"
            note "Credentials now travel unencrypted. Re-enable with: gbx ssl on"
            ;;
        letsencrypt|le)
            domain="$(env_get GBX_DOMAIN)"
            [ -n "$domain" ] || die "bind a domain first: gbx domain panel.example.com"
            email="${2:-}"
            [ -z "$email" ] && email="$(ask "E-mail for Let's Encrypt notices: ")"
            [[ "$email" =~ ^[^@[:space:]]+@[^@[:space:]]+\.[^@[:space:]]+$ ]] || die "invalid e-mail"
            command -v certbot >/dev/null || DEBIAN_FRONTEND=noninteractive apt-get install -y certbot >/dev/null

            # port 80 must answer for the domain: use the website root if one exists, else the default site
            webroot="/www/wwwroot/default"
            if [ -f "/etc/apache2/sites-enabled/gbx-${domain}.conf" ]; then
                webroot="$(awk '/DocumentRoot/ {print $2; exit}' "/etc/apache2/sites-enabled/gbx-${domain}.conf")"
            fi
            mkdir -p "$webroot/.well-known/acme-challenge"
            echo "Requesting certificate for ${domain} (webroot ${webroot})..."
            certbot certonly --webroot -w "$webroot" -d "$domain" --non-interactive --agree-tos -m "$email" \
                --cert-name "gbxpanel-${domain}" --keep-until-expiring --deploy-hook "systemctl reload apache2" \
                || die "certbot failed. Check that ${domain} points to this server and port 80 is open."
            env_set GBX_SSL true
            env_set GBX_SSL_CERT "/etc/letsencrypt/live/gbxpanel-${domain}/fullchain.pem"
            env_set GBX_SSL_KEY "/etc/letsencrypt/live/gbxpanel-${domain}/privkey.pem"
            write_vhost
            okay "Let's Encrypt certificate installed. Renewal is automatic."
            cmd_info
            ;;
        *)
            echo "Usage: gbx ssl on | off | letsencrypt <email> | selfsigned"
            ;;
    esac
}

cmd_domain() {
    local domain="${1:-}" old
    old="$(env_get GBX_DOMAIN)"
    [ -z "$domain" ] && domain="$(ask "Domain to bind (e.g. panel.example.com, off = remove): ")"
    if [ "$domain" = "off" ] || [ "$domain" = "none" ]; then
        env_set GBX_DOMAIN ""
        # a Let's Encrypt certificate is only valid for the domain
        if [[ "$(env_get GBX_SSL_CERT)" == /etc/letsencrypt/* ]]; then
            env_set GBX_SSL_CERT "$SELF_CERT"; env_set GBX_SSL_KEY "$SELF_KEY"
        fi
        write_vhost
        okay "Domain binding removed. The panel answers on the server IP again: $(panel_url)"
        return
    fi
    domain="${domain,,}"
    [[ "$domain" =~ ^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$ ]] || die "invalid domain name"

    local resolved ip
    resolved="$(getent ahostsv4 "$domain" 2>/dev/null | awk '{print $1; exit}')"
    ip="$(public_ip)"
    if [ "$resolved" != "$ip" ]; then
        note "Warning: ${domain} resolves to '${resolved:-nothing}', this server is ${ip}."
        note "After binding, the panel only answers on ${domain}. If DNS is wrong you can remove it with: gbx domain off"
        [ -t 0 ] && ! confirm "Bind anyway?" && return
    fi
    env_set GBX_DOMAIN "$domain"
    if [ -n "$old" ] && [ "$old" != "$domain" ] && [[ "$(env_get GBX_SSL_CERT)" == /etc/letsencrypt/* ]]; then
        env_set GBX_SSL_CERT "$SELF_CERT"; env_set GBX_SSL_KEY "$SELF_KEY"
    fi
    write_vhost
    okay "Panel bound to ${domain}: $(panel_url)"
    is_true "$(env_get GBX_SSL)" && [[ "$(env_get GBX_SSL_CERT)" != /etc/letsencrypt/* ]] && note "Tip: issue a trusted certificate with: gbx ssl letsencrypt you@example.com"
}

cmd_cache() {
    artisan optimize:clear >/dev/null
    artisan cache:clear >/dev/null
    artisan view:cache >/dev/null
    okay "Panel cache cleared."
}

cmd_unlock_login() { artisan gbx:clear-login-limit; }

cmd_unlock_ip() { artisan gbx:reset-access; }

cmd_fix() {
    chown -R "$GBX_USER:$GBX_USER" "$PANEL_DIR"
    find "$PANEL_DIR" -type d -not -path '*/storage/*' -exec chmod 755 {} +
    find "$PANEL_DIR" -type f -not -path '*/storage/*' -exec chmod 644 {} +
    chmod 755 "$PANEL_DIR/artisan"
    chmod -R u+rwX,g+rwX,o-rwx "$PANEL_DIR/storage" "$PANEL_DIR/bootstrap/cache"
    chmod 700 "$PANEL_DIR/database"
    chmod 600 "$ENV_FILE" "$PANEL_DIR"/database/database.sqlite* 2>/dev/null
    clear_cache_quiet
    okay "Permissions repaired."
}

cmd_update() {
    local tmp src
    tmp="$(mktemp -d)"
    echo "Downloading ${GBX_REPO} (${GBX_BRANCH})..."
    curl -fsSL "${GBX_REPO%/}/archive/refs/heads/${GBX_BRANCH}.tar.gz" -o "$tmp/panel.tar.gz" || die "download failed"
    tar -xzf "$tmp/panel.tar.gz" -C "$tmp"
    src="$(dirname "$(find "$tmp" -maxdepth 3 -path '*/panel/artisan' | head -1)")"
    [ -f "$src/artisan" ] || die "invalid archive"

    cp "$PANEL_DIR/database/database.sqlite" "$GBX_ROOT/backup/database-$(date +%Y%m%d%H%M%S).sqlite"
    # patterns are anchored with "/" so only the top-level vendor/ (composer) is skipped,
    # not public/assets/vendor/ (bundled front-end libraries)
    rsync -a --delete --exclude='/.env' --exclude='/database/*.sqlite*' --exclude='/storage/' --exclude='/vendor/' "$src/" "$PANEL_DIR/"
    install -m 755 "$(dirname "$src")/scripts/gbx" "$GBX_ROOT/bin/gbx"
    chown -R "$GBX_USER:$GBX_USER" "$PANEL_DIR"
    (cd "$PANEL_DIR" && runuser -u "$GBX_USER" -- env HOME="$GBX_ROOT" COMPOSER_HOME="$GBX_ROOT/.composer" "$PHP_BIN" /usr/local/bin/composer install --no-dev --optimize-autoloader --no-interaction --no-progress) || die "composer install failed"
    artisan migrate --force
    install -m 700 "$(dirname "$src")/scripts/gbx-terminal" "$TERM_BIN"
    rm -rf "$tmp"
    cmd_fix >/dev/null
    # render cron jobs again: the runner and task scripts can change between versions
    artisan gbx:cron-sync >/dev/null || echo "Warning: cron jobs could not be synchronized (open Home > Cron Jobs and save a task)" >&2
    ensure_panel_fpm
    ensure_terminal_service
    write_vhost
    cmd_restart
    okay "GBX Panel updated."
}

cmd_logs() {
    local f
    f="$(ls -t "$PANEL_DIR"/storage/logs/*.log 2>/dev/null | head -1)"
    echo -e "${D}== ${f:-no laravel log} ==${N}"; [ -n "$f" ] && tail -n 60 "$f"
    for log in php-error.log php-fpm.log apache-error.log worker.log; do
        echo -e "${D}== $GBX_ROOT/logs/${log} ==${N}"; tail -n 25 "$GBX_ROOT/logs/${log}" 2>/dev/null
    done
    echo -e "${D}== journalctl -u gbxpanel-terminal ==${N}"; journalctl -u gbxpanel-terminal -n 15 --no-pager 2>/dev/null
}

cmd_fpm() {
    ensure_panel_fpm
    write_vhost
    okay "gbxpanel-fpm is running on ${FPM_SOCK}."
}

cmd_tools_access() {
    case "${1:-}" in
        public)
            env_set GBX_TOOLS_PUBLIC true
            ;;
        private)
            [ -n "$(env_get GBX_TOOLS_TOKEN)" ] || env_set GBX_TOOLS_TOKEN "$(openssl rand -hex 24)"
            env_set GBX_TOOLS_PUBLIC false
            ;;
        *) die "usage: gbx tools-access public|private" ;;
    esac
    write_vhost
    okay "phpMyAdmin and Adminer access set to $1."
}

cmd_terminal() {
    case "${1:-on}" in
        on|start|enable)
            ensure_terminal_service
            write_vhost
            okay "Real-time terminal is running on 127.0.0.1:$(terminal_port) (proxied at /gbx-terminal/)."
            ;;
        off|stop|disable)
            systemctl disable --now gbxpanel-terminal >/dev/null 2>&1
            note "Real-time terminal stopped. The Terminal page falls back to command mode."
            ;;
        restart)
            systemctl restart gbxpanel-terminal && okay "Real-time terminal restarted (open sessions were closed)."
            ;;
        status)
            systemctl --no-pager status gbxpanel-terminal | head -12
            ;;
        *) die "usage: gbx terminal [on|off|status|restart]" ;;
    esac
}

# Check the pieces the panel needs and print the first problem found for each.
cmd_doctor() {
    local fail=0 port entry code probe
    check() { if eval "$2" >/dev/null 2>&1; then echo -e "  ${G}ok${N}    $1"; else echo -e "  ${R}fail${N}  $1 ${D}$3${N}"; fail=$((fail + 1)); fi; }
    port="$(env_get GBX_PORT)"; entry="$(env_get GBX_ENTRY)"
    echo -e "\n  ${W}${B}GBX Panel doctor${N}\n"
    check "apache2 running" "systemctl is-active --quiet apache2" "(systemctl status apache2)"
    check "apache configuration" "apache2ctl configtest" "(apache2ctl configtest)"
    check "gbxpanel-fpm running" "systemctl is-active --quiet gbxpanel-fpm" "(run: gbx fpm)"
    check "PHP-FPM socket ${FPM_SOCK}" "[ -S \"$FPM_SOCK\" ]" "(run: gbx fpm)"
    check "no legacy pool in sandboxed php8.4-fpm" "[ ! -f /etc/php/8.4/fpm/pool.d/gbxpanel.conf ]" "(run: gbx fpm)"
    check "vhost uses the dedicated socket" "grep -q \"$FPM_SOCK\" \"$VHOST\"" "(run: gbx vhost)"
    check "queue worker running" "supervisorctl status gbxpanel-worker:* | grep -q RUNNING" "(supervisorctl status)"
    check "APP_KEY is set" "grep -qE \"^APP_KEY=base64:.+\" \"$ENV_FILE\"" "(php artisan key:generate)"
    check ".env readable by ${GBX_USER}" "runuser -u $GBX_USER -- test -r \"$ENV_FILE\"" "(run: gbx fix)"
    for dir in storage/framework/views storage/framework/cache/data storage/framework/sessions storage/logs bootstrap/cache database; do
        check "${dir} writable by ${GBX_USER}" "runuser -u $GBX_USER -- test -w \"$PANEL_DIR/$dir\"" "(run: gbx fix)"
    done
    check "gbxpanel-terminal running" "systemctl is-active --quiet gbxpanel-terminal" "(run: gbx terminal)"
    check "terminal daemon answers on 127.0.0.1:$(terminal_port)" "curl -fs --max-time 3 http://127.0.0.1:$(terminal_port)/health" "(gbx terminal status)"
    check "apache proxy_wstunnel enabled" "apache2ctl -M 2>/dev/null | grep -q proxy_wstunnel" "(a2enmod proxy_wstunnel)"
    check "sudo available to ${GBX_USER}" "runuser -u $GBX_USER -- sudo -n true" "(/etc/sudoers.d/gbxpanel)"
    check "artisan boots" "artisan about --only=environment" "(gbx logs)"
    probe="${entry:+/$entry}"
    code="$(curl -k -s -o /dev/null -w "%{http_code}" -L -c /tmp/.gbx-doctor -b /tmp/.gbx-doctor "$(scheme)://127.0.0.1:${port}${probe}" 2>/dev/null || true)"
    rm -f /tmp/.gbx-doctor
    check "login page responds (HTTP ${code:-none})" "[ \"$code\" = 200 ]" "(gbx logs)"
    echo
    if [ "$fail" -eq 0 ]; then okay "  Everything looks good."; else note "  ${fail} problem(s) found. Try: gbx fix && gbx fpm, then gbx logs."; fi
    echo
}
cmd_uninstall() {
    [ -x "$GBX_ROOT/bin/uninstall.sh" ] || die "uninstaller not found"
    "$GBX_ROOT/bin/uninstall.sh"
}

# ------------------------------------------------------------------ menu
run_option() {
    case "$1" in
        1) cmd_restart ;;
        2) cmd_stop ;;
        3) cmd_start ;;
        4) cmd_status ;;
        5) cmd_password ;;
        6) cmd_username ;;
        7) cmd_info ;;
        8) cmd_default ;;
        9) cmd_port ;;
        10) cmd_entry ;;
        11) cmd_entry off ;;
        12) cmd_ssl on ;;
        13) cmd_ssl off ;;
        14) cmd_ssl letsencrypt ;;
        15) cmd_domain ;;
        16) cmd_domain off ;;
        17) cmd_cache ;;
        18) cmd_unlock_login ;;
        19) cmd_unlock_ip ;;
        20) cmd_fix ;;
        21) cmd_update ;;
        22) cmd_logs ;;
        23) cmd_uninstall ;;
        24) cmd_doctor ;;
        25) cmd_terminal on ;;
        26) cmd_terminal off ;;
        27) cmd_2fa_off ;;
        0|q|"") exit 0 ;;
        *) echo "Invalid option: $1" ;;
    esac
}

menu() {
    clear 2>/dev/null
    echo -e "${W}${B}"
    echo "  ======================= GBX Panel CLI ========================"
    echo -e "${N}"
    echo "   (1)  Restart panel                (12) Enable panel SSL"
    echo "   (2)  Stop panel                   (13) Disable panel SSL"
    echo "   (3)  Start panel                  (14) Let's Encrypt cert for panel domain"
    echo "   (4)  Panel status                 (15) Bind domain to panel"
    echo "   (5)  Change panel password        (16) Unbind panel domain"
    echo "   (6)  Change panel username        (17) Clear panel cache"
    echo "   (7)  Panel URL and login          (18) Clear login limit"
    echo "   (8)  Initial login (if unchanged) (19) Clear IP allow list"
    echo "   (9)  Change panel port            (20) Repair permissions"
    echo "   (10) Change security entrance     (21) Update panel"
    echo "   (11) Disable security entrance    (22) View error logs"
    echo "                                     (23) Uninstall panel"
    echo "                                     (24) Diagnose problems"
    echo "                                     (25) Enable real-time terminal"
    echo "                                     (26) Disable real-time terminal"
    echo "                                     (27) Disable two-factor login"
    echo "   (0)  Exit"
    echo -e "${W}${B}  ==============================================================${N}"
    echo
    local choice
    choice="$(ask "  Enter an option [0-27]: ")"
    echo
    run_option "$choice"
}

case "${1:-}" in
    "") menu ;;
    [0-9]|[0-9][0-9]) run_option "$1" ;;
    info|default|status|restart|stop|start|cache|fix|update|logs|uninstall) "cmd_$1" ;;
    password|passwd) cmd_password "${2:-}" ;;
    username) cmd_username "${2:-}" ;;
    2fa-off|two-factor-off) cmd_2fa_off "${2:-}" ;;
    port) cmd_port "${2:-}" ;;
    entry) cmd_entry "${2:-}" ;;
    ssl) cmd_ssl "${2:-}" "${3:-}" ;;
    domain) cmd_domain "${2:-}" ;;
    unlock-login) cmd_unlock_login ;;
    unlock-ip|unlock) cmd_unlock_ip ;;
    vhost) write_vhost; okay "Panel virtual host regenerated." ;;
    fpm) cmd_fpm ;;
    fpm-service) ensure_panel_fpm; okay "gbxpanel-fpm is running on ${FPM_SOCK}." ;;
    doctor) cmd_doctor ;;
    terminal) cmd_terminal "${2:-on}" ;;
    tools-access) cmd_tools_access "${2:-}" ;;
    -h|--help|help) sed -n '3,30p' "$0" ;;
    *) die "unknown command: $1 (see gbx help)" ;;
esac
